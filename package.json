{
  "name": "@quizpot/quizcore",
  "version": "0.0.17",
  "description": "Core library for Quizpot",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts --clean && mkdir -p dist/db && cp src/db/schema.ts dist/db/schema.ts",
    "watch": "tsdown src/index.ts --format esm,cjs --dts --watch"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./db/schema": "./dist/db/schema.ts"
  },
  "devDependencies": {
    "tsdown": "^0.21.7",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "uuid": "^13.0.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  }
}
